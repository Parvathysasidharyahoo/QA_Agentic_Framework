# Copy to .env (project root) and fill in. Never commit .env — it is git-ignored.
# This is the project's only .env: the QA Agent UI (npm start in AgentUI/) and the agents both read it.

# --- Claude (the agents) ---
# On a shared server, use a company Anthropic API key rather than a personal Claude sign-in.
ANTHROPIC_API_KEY=
# Alternative: Claude through Microsoft Foundry instead of the Anthropic API
# CLAUDE_CODE_USE_FOUNDRY=1
# ANTHROPIC_FOUNDRY_RESOURCE=your-foundry-resource-name
# ANTHROPIC_FOUNDRY_API_KEY=

# --- Jira (defect-triage-agent files bugs here) ---
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-api-token

# --- QA Agent UI ---
# Required whenever anyone other than you can reach the UI: agents run with permission checks off.
UI_PASSWORD=change-me
PORT=4000
# false on a server with no logged-in desktop (Linux VM, or Windows VM without auto-logon)
PLAYWRIGHT_HEADED=true

# --- Corporate network (only if needed) ---
# HTTPS_PROXY=http://proxy.company.local:8080
# NO_PROXY=localhost,127.0.0.1,.company.local
# PEM file of the company root certificate, if outbound HTTPS is TLS-inspected
# NODE_EXTRA_CA_CERTS=/path/to/company-root-ca.pem
# Windows only: path to Git Bash if Git is installed somewhere unusual
# CLAUDE_CODE_GIT_BASH_PATH=C:\Program Files\Git\bin\bash.exe
