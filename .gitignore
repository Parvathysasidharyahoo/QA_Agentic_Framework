# Secrets
.env
*.env

# Dependencies
node_modules/

# Playwright artifacts (regenerated on every run)
TestAutomate/test-results/
TestAutomate/playwright-report/
TestAutomate/blob-report/

# Local UI run state and log
AgentUI/runs.json
